# ==============================================================================
# OTel Training — environment sample
# ==============================================================================
#
# HOW TO USE THIS FILE
#
#   1. Copy it to `.env` in the repo root:
#          cp .env.sample .env
#   2. Open `.env` and fill in your own values (see each section below).
#   3. Run the environment:  `make up`   (or `bash .devcontainer/bootstrap/deploy-environment.sh`)
#
# `.env` is gitignored — it never gets committed, so it is safe to put real
# tokens in it. NEVER put real tokens in this `.env.sample` file.
#
# In GitHub Codespaces you normally do NOT need a `.env` at all: the same
# variables are injected as Codespaces secrets
# (Settings → Codespaces → Secrets). Use `.env` for local / non-Codespaces runs.
#
# This sample mirrors the per-attendee contract in `.devcontainer/.env.example`
# and documents every variable the root entrypoints
# (`Makefile` → `.devcontainer/bootstrap/deploy-environment.sh`) consume.
#
# Relationship to `.devcontainer/.env.example`: this root sample COMPLEMENTS it,
# it does not supersede it. They share one variable vocabulary but map to
# different files — this one → root `.env` (what `make` / the orchestrator read
# from the repo root); the devcontainer one → `.devcontainer/.env`. Keep the two
# in sync and do not invent new var names. In Codespaces, Codespaces secrets
# supersede both.
# ------------------------------------------------------------------------------


# --- Dynatrace tenant connection (OPTIONAL — graceful degradation) ------------
# The core trio (DT_TENANT + DT_OPERATOR_TOKEN + DT_INGEST_TOKEN) is OPTIONAL for
# bring-up. If any is missing, the orchestrator still brings up the cluster,
# observability (in a no-export mode where collectors run but cannot forward to
# Dynatrace), and the casino — then prints which labs are limited. Set all three
# and re-run `make up` to enable the full telemetry path. DT_PLATFORM_TOKEN is a
# separate, additionally-optional var used only by the dtctl labs.
#
# Canonical contract: docs-site/setup.md §"Environment variables". Keep this
# block, .devcontainer/.env.example, and that table in agreement.
#
# Tenant URL, e.g. https://abc12345.live.dynatrace.com. One base URL serves both
# the operator (<DT_TENANT>/api) and the OTLP collectors (<DT_TENANT>/api/v2/otlp).
DT_TENANT=
# Operator / ActiveGate API token — classic API token (dt0c01), operator scopes.
# Becomes the DynaKube `apiToken` (scopes per ISI-6793 / deploy/dynatrace/README.md).
DT_OPERATOR_TOKEN=
# DEPRECATED alias: DT_API_TOKEN. install.sh still honours it as a fallback so an
# existing secret does not break mid-training. Prefer DT_OPERATOR_TOKEN.
# DT_API_TOKEN=
# Data-ingest token — classic API token (dt0c01), ingest scopes. TWO consumers:
# the OTel collectors' OTLP exporter AND the operator `dataIngestToken`.
DT_INGEST_TOKEN=
# Platform token for `dtctl` ONLY — a platform token (dt0s16), NOT a classic API
# token. Optional: only the dtctl-based labs need it.
DT_PLATFORM_TOKEN=
# Optional Gen3 SaaS platform URL for dtctl, e.g. https://<id>.apps.dynatrace.com.
# Leave blank to derive from DT_TENANT (<id>.live... -> <id>.apps...).
# DT_PLATFORM_URL=


# --- Cluster / isolation ------------------------------------------------------
# PARTICIPANT_ID is the ONE knob you set to make your run unique. It becomes:
#   - your kind cluster name,
#   - the `k8s.cluster.name` dimension on every piece of telemetry, and
#   - your DynaKube name.
# Must be unique per attendee (e.g. first name + initial). Because it is used as
# a kind cluster / Kubernetes name, keep it DNS-label-safe: lowercase
# alphanumeric and `-` only, no spaces or uppercase (e.g. `alicew`, not `Alice W`).
# Leaving it blank falls back to `otel-training` — fine for a solo run, but it
# COLLIDES with everyone else in a shared class, so always set it there.
PARTICIPANT_ID=

# Advanced override: KIND_CLUSTER_NAME, if set, wins over PARTICIPANT_ID and
# names the cluster directly. Most attendees leave this blank and just set
# PARTICIPANT_ID above.
# KIND_CLUSTER_NAME=


# --- Environment orchestrator -------------------------------------------------
# FULL_DEPLOY=on makes postCreate/postStart run deploy-environment.sh on
# container start, bringing up observability + Dynatrace + the GitOps-synced
# casino automatically. Leave off to provision the cluster only and deploy by
# hand with `make up`. Values: on|off (also accepts 1/true/yes).
FULL_DEPLOY=off

# Casino delivery path used by the orchestrator:
#   gitops  — Argo CD syncs the casino manifests (default; preserves the lab loop)
#   direct  — kubectl apply straight to the casino namespace (debug / no GitOps)
DEPLOY_MODE=gitops


# --- GitOps provider (only used when DEPLOY_MODE=gitops) ----------------------
# Which git host Argo CD syncs from:
#   gitlab  — an external GitLab fork you own (default)
#   gitea   — the in-cluster Gitea (fallback; used automatically if GITLAB_* unset)
GITOPS_PROVIDER=gitlab

# Your casino fork URL, e.g. https://<host>/<attendee>/casino.git
# Required when GITOPS_PROVIDER=gitlab; if blank the orchestrator falls back to
# the in-cluster Gitea.
GITLAB_REPO_URL=
# Your GitLab token (injected as a Codespace secret in the hosted path).
# Required when GITOPS_PROVIDER=gitlab.
GITLAB_TOKEN=


# --- Workshop LLM proxy (advanced track, Step 1 / opencode) -------------------
# NOTE: these are NOT Dynatrace tokens — they authenticate opencode's LLM
# dispenser (ISI-7138) and are unrelated to the DT_* tenant vars above.
# The advanced instrumentation lab drives the `opencode` CLI, which talks to a
# facilitator-hosted LiteLLM proxy. On container start, dispense-llm.sh calls the
# dispenser once to mint a per-attendee proxy key and wires opencode to it.
# Both values are injected as Codespace secrets in the facilitated workshop.
# When either is absent, dispense-llm.sh skips cleanly (exit 0) and the opencode
# AI steps are simply unavailable — nothing else is affected. The per-attendee
# budget is enforced server-side on the proxy; there is no client-side budget.
# Keep WORKSHOP_ROOM_PASSWORD secret — never commit it.
#
# Dispenser endpoint that mints a per-attendee LiteLLM proxy key.
WORKSHOP_DISPENSER_URL=
# Shared room password sent as the X-Room-Password header to the dispenser.
WORKSHOP_ROOM_PASSWORD=


# --- Optional tool version pins (override image defaults) ---------------------
# Uncomment and set to pin a specific tool version; otherwise image defaults win.
# KUBECTL_VERSION=v1.31.2
# HELM_VERSION=v3.16.4
# KIND_VERSION=v0.25.0
# ARGOCD_VERSION=v2.13.2
# YQ_VERSION=v4.44.6
# DTCTL_VERSION=v0.45.0        # Dynatrace/dtctl release tag, or "latest" to resolve newest
# DTCTL_REPO=Dynatrace/dtctl   # override if dtctl is mirrored to another org/repo
# DTCTL_DOWNLOAD_URL=          # direct .tar.gz or binary URL if your region/source differs
# OPENCODE_VERSION=v1.19.5     # sst/opencode release tag, or "latest" to resolve newest
# OPENCODE_REPO=sst/opencode   # override if opencode is mirrored to another org/repo
# OPENCODE_DOWNLOAD_URL=       # direct .tar.gz URL if your region/source differs
