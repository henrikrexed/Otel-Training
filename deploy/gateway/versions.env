# Pinned component versions for the Gateway API exposure layer (ISI-6795).
#
# Bump deliberately and in lockstep: NGINX Gateway Fabric 2.8.0 is validated
# against Gateway API 1.6.3 (see the NGF release notes). The data-plane image
# tag is derived from NGF_VERSION inside the installer.
export GATEWAY_API_VERSION="${GATEWAY_API_VERSION:-v1.6.3}"
export NGF_VERSION="${NGF_VERSION:-v2.8.0}"

# NodePort the casino is exposed on. Must stay inside the default service
# NodePort range (30000-32767) AND inside the band kind-config.yaml publishes
# (30000-30002) + devcontainer.json forwards. Changing this means updating both.
export CASINO_HTTP_NODEPORT="${CASINO_HTTP_NODEPORT:-30000}"
