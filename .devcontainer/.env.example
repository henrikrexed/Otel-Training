# OTel Training — per-attendee environment variables.
#
# ⚠️  Do NOT commit real tokens. These values are injected per attendee via
#     GitHub Codespaces secrets (Settings → Codespaces → Secrets) or repository
#     secrets — never baked into the devcontainer image.
#
# Copy to `.env` locally only for non-Codespaces testing; `.env` is gitignored.

# --- Dynatrace tenant connection (shared tenant, per-attendee isolation) ---
# Tenant URL, e.g. https://abc12345.live.dynatrace.com
DT_TENANT=

# API token used by dtctl / config tooling. Scopes needed are documented per
# downstream ticket (DT operator = ISI-6793). Keep least-privilege.
DT_API_TOKEN=

# Data-ingest token used by collectors/operator to send OTLP to the tenant.
DT_INGEST_TOKEN=

# --- Cluster / isolation ---
# Each attendee gets a uniquely-named kind cluster + a per-attendee service.name
# on the shared tenant (decision of record on ISI-4025). Keep this unique.
KIND_CLUSTER_NAME=otel-training

# --- Environment orchestrator (ISI-6837) ---
# FULL_DEPLOY=on makes postCreate/postStart run deploy-environment.sh, bringing
# up observability + Dynatrace + the GitOps-synced casino automatically. The
# TRAINING prebuild sets this on; the reusable base leaves it off (cluster only).
# Values: on|off (also accepts 1/true/yes).
FULL_DEPLOY=off

# Casino delivery path used by the orchestrator:
#   gitops  — Argo CD syncs deploy/casino/k8s (default; preserves the lab loop)
#   direct  — kubectl apply straight to the casino namespace (debug / no GitOps)
DEPLOY_MODE=gitops

# --- Graceful-degradation contract (ISI-6837 AC #3) ---
# DT_TENANT / DT_API_TOKEN / DT_INGEST_TOKEN are OPTIONAL for bring-up. When they
# are absent the orchestrator still brings up the cluster, observability (in a
# no-export mode where collectors run but cannot forward to Dynatrace), and the
# casino — then prints which labs are limited (Dynatrace K8s monitoring, reading
# casino signals in the tenant). Set the three DT_* values and re-run
# `make up` (or deploy-environment.sh) to enable the full telemetry path.

# --- Optional tool version pins (override image defaults) ---
# KUBECTL_VERSION=v1.31.2
# HELM_VERSION=v3.16.4
# KIND_VERSION=v0.25.0
# ARGOCD_VERSION=v2.13.2
# YQ_VERSION=v4.44.6
# DTCTL_VERSION=v0.45.0        # Dynatrace/dtctl release tag, or "latest" to resolve newest
# DTCTL_REPO=Dynatrace/dtctl   # override if dtctl is mirrored to another org/repo
# DTCTL_DOWNLOAD_URL=          # direct .tar.gz or binary URL if your region/source differs
