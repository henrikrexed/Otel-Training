# OTel Training — per-attendee environment variables.
#
# ⚠️  Do NOT commit real tokens. These values are injected per attendee via
#     GitHub Codespaces secrets (Settings → Codespaces → Secrets) or repository
#     secrets — never baked into the devcontainer image.
#
# Copy to `.env` locally only for non-Codespaces testing; `.env` is gitignored.

# --- Dynatrace tenant connection (shared tenant, per-attendee isolation) ---
# Tenant URL, e.g. https://abc12345.live.dynatrace.com
DT_TENANT=

# API token used by dtctl / config tooling. Scopes needed are documented per
# downstream ticket (DT operator = ISI-6793). Keep least-privilege.
DT_API_TOKEN=

# Data-ingest token used by collectors/operator to send OTLP to the tenant.
DT_INGEST_TOKEN=

# --- Cluster / isolation ---
# Each attendee gets a uniquely-named kind cluster + a per-attendee service.name
# on the shared tenant (decision of record on ISI-4025). Set PARTICIPANT_ID to a
# DNS-label-safe id (lowercase alphanumeric + `-`, no spaces/uppercase); it names
# the kind cluster, the `k8s.cluster.name` dimension, and the DynaKube. Blank
# falls back to otel-training (collides in a shared class).
PARTICIPANT_ID=
# Advanced override: wins over PARTICIPANT_ID when set. Leave blank normally.
# KIND_CLUSTER_NAME=otel-training

# --- Workshop LLM proxy (advanced track, Step 1 / opencode) ---
# Both are injected as Codespace secrets in the facilitated workshop. When they
# are absent, dispense-llm.sh skips cleanly and the opencode AI steps are simply
# unavailable — nothing else is affected. Keep WORKSHOP_ROOM_PASSWORD secret.
# Dispenser endpoint that mints a per-attendee LiteLLM proxy key.
WORKSHOP_DISPENSER_URL=
# Shared room password sent as the X-Room-Password header to the dispenser.
WORKSHOP_ROOM_PASSWORD=

# --- Optional tool version pins (override image defaults) ---
# KUBECTL_VERSION=v1.31.2
# HELM_VERSION=v3.16.4
# KIND_VERSION=v0.25.0
# ARGOCD_VERSION=v2.13.2
# YQ_VERSION=v4.44.6
# DTCTL_VERSION=v0.45.0        # Dynatrace/dtctl release tag, or "latest" to resolve newest
# DTCTL_REPO=Dynatrace/dtctl   # override if dtctl is mirrored to another org/repo
# DTCTL_DOWNLOAD_URL=          # direct .tar.gz or binary URL if your region/source differs
# OPENCODE_VERSION=v1.19.5     # sst/opencode release tag, or "latest" to resolve newest
# OPENCODE_REPO=sst/opencode   # override if opencode is mirrored to another org/repo
# OPENCODE_DOWNLOAD_URL=       # direct .tar.gz URL if your region/source differs
